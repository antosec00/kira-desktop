[Unit]
Description=Kira Desktop user runtime
Documentation=file:/usr/share/doc/kira-desktop/README.md
After=default.target
# A service that keeps refusing to start (for example a newer database) stops retrying.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/kira-desktop service
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
